# Copy to .env and fill in. .env is never committed.
DATABASE_URL=postgres://junro:junro@localhost:5434/junro
TEST_DATABASE_URL=postgres://junro:junro@localhost:5434/junro_test

# Server
SESSION_SECRET=change-me-to-a-long-random-string
CLIENT_URL=http://localhost:5173
PORT=3000

# Google sign-in: uncomment and fill all three, or leave all three out. See README.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Google Places and Routes (server-side key, see README). Without it, search/solve answer 503.
# GOOGLE_API_KEY=
# Optional monthly caps (defaults are well below Google's free tiers). 0 switches an API off.
# GOOGLE_CAP_AUTOCOMPLETE=5000
# GOOGLE_CAP_PLACE_DETAILS=800
# GOOGLE_CAP_ROUTE_MATRIX=4000
# GOOGLE_CAP_COMPUTE_ROUTES=4000
